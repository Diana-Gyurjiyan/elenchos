# Copy to .env (make env does this). Never commit .env.

# --- Model (sample capability) ---------------------------------------------
LOG_LEVEL=INFO
# Ollama is the default provider; Anthropic is also supported.
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=16384

# Optional Anthropic server-side fallback. Users can also enter a key in the UI.
ANTHROPIC_API_KEY=
MODEL_QUICK=claude-haiku-5-5
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-opus-5-5

# --- Database (store capability) -------------------------------------------
POSTGRES_USER=argmap
POSTGRES_PASSWORD=argmap
POSTGRES_DB=argmap
POSTGRES_PORT=5433

# store: postgres | memory (memory is temporary)
STORE_ADAPTER=postgres
